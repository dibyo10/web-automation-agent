# Required: your paid Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults live in config/index.js)
# BRAIN_MODEL=gemini-3.5-flash
# VISION_MODEL=gemini-3.5-flash

# The default goal, used when you DON'T pass one on the command line.
# You can also just run:
#   node index.js "open youtube, search world cup 2026, and play the 5th video"
# TASK=Open https://www.youtube.com, search for "world cup 2026", and play the 5th video.

# Browser behaviour
# HEADLESS=false
# SLOW_MO=80
# TYPING_DELAY_MS=5
# NAV_TIMEOUT_MS=45000

# Agent loop limits
# MAX_ITERATIONS=40
# TASK_TIMEOUT_MS=300000
